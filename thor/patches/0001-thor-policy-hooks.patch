diff --git a/lib/thor_policy.h b/lib/thor_policy.h
new file mode 100644
index 0000000..57d14c1
--- /dev/null
+++ b/lib/thor_policy.h
@@ -0,0 +1,29 @@
+/*
+ * thor: политика безопасности void-hardened внутри libxbps.
+ * Реализация — на Zig (thor/policy/policy.zig, объектный файл thor_policy.o),
+ * поэтому действует во всех программах xbps-*, а не только в thor.
+ *
+ * Пути передаются от корня системы ("/usr/bin/doas"); rootdir — корень установки
+ * (xhp->rootdir, "/" или, например, "/mnt" при установке системы).
+ */
+#ifndef THOR_POLICY_H
+#define THOR_POLICY_H
+
+enum {
+	THOR_EXTRACT = 0,  /* распаковать (возможно, с изменённым *mode) */
+	THOR_SKIP = 1,     /* не распаковывать */
+};
+
+/* Перед распаковкой файла: решение и, возможно, новый режим (без SUID/SGID). */
+int thor_unpack_entry(const char *rootdir, const char *pkgver, const char *path,
+		      unsigned int *mode);
+/* Сразу после распаковки файла: проверка содержимого (правила udev). */
+void thor_after_extract(const char *rootdir, const char *pkgver, const char *path);
+/* Пакет в транзакции (install, update, reinstall): 0 — можно, иначе в *reason —
+ * причина запрета (статическая строка). */
+int thor_transaction_pkg(const char *rootdir, const char *pkgname, const char **reason);
+/* Файл пакета после настройки (скрипты INSTALL уже отработали): SUID и
+ * capabilities, которые поставили скрипты; отчёт о сервисах (installed != 0). */
+void thor_post_file(const char *rootdir, const char *pkgver, const char *path, int installed);
+
+#endif
diff --git a/lib/transaction_commit.c b/lib/transaction_commit.c
index b2b0594..32bb6ef 100644
--- a/lib/transaction_commit.c
+++ b/lib/transaction_commit.c
@@ -34,6 +34,7 @@
 #include <locale.h>
 
 #include "xbps_api_impl.h"
+#include "thor_policy.h"
 
 /**
  * @file lib/transaction_commit.c
@@ -99,6 +100,42 @@ out:
 	return rv;
 }
 
+/*
+ * thor: файлы установленных и обновлённых пакетов после скриптов INSTALL
+ * (thor_policy.h): SUID и capabilities, которые поставили скрипты.
+ */
+static void
+thor_post_scan(struct xbps_handle *xhp)
+{
+	static const char *const kinds[] = { "files", "conf_files" };
+	xbps_array_t pkgs = xbps_dictionary_get(xhp->transd, "packages");
+
+	for (unsigned int i = 0; i < xbps_array_count(pkgs); i++) {
+		xbps_dictionary_t obj = xbps_array_get(pkgs, i), filesd;
+		const char *pkgname = NULL, *pkgver = NULL;
+		xbps_trans_type_t ttype = xbps_transaction_pkg_type(obj);
+
+		if (ttype != XBPS_TRANS_INSTALL && ttype != XBPS_TRANS_UPDATE &&
+		    ttype != XBPS_TRANS_REINSTALL)
+			continue;
+		if (!xbps_dictionary_get_cstring_nocopy(obj, "pkgname", &pkgname) ||
+		    !xbps_dictionary_get_cstring_nocopy(obj, "pkgver", &pkgver))
+			continue;
+		if ((filesd = xbps_pkgdb_get_pkg_files(xhp, pkgname)) == NULL)
+			continue;
+		for (unsigned int k = 0; k < 2; k++) {
+			xbps_array_t a = xbps_dictionary_get(filesd, kinds[k]);
+			for (unsigned int j = 0; j < xbps_array_count(a); j++) {
+				const char *file = NULL;
+				xbps_dictionary_get_cstring_nocopy(xbps_array_get(a, j), "file", &file);
+				if (file != NULL)
+					thor_post_file(xhp->rootdir, pkgver, file,
+					    ttype == XBPS_TRANS_INSTALL);
+			}
+		}
+	}
+}
+
 int
 xbps_transaction_commit(struct xbps_handle *xhp)
 {
@@ -447,5 +484,7 @@ out:
 		/* Force a pkgdb write for all unpacked pkgs in transaction */
 		rv = xbps_pkgdb_update(xhp, true, true);
 	}
+	if (rv == 0 && !(xhp->flags & XBPS_FLAG_DOWNLOAD_ONLY))
+		thor_post_scan(xhp);
 	return rv;
 }
diff --git a/lib/transaction_prepare.c b/lib/transaction_prepare.c
index 814559f..8eb74a7 100644
--- a/lib/transaction_prepare.c
+++ b/lib/transaction_prepare.c
@@ -31,6 +31,7 @@
 #include <sys/statvfs.h>
 
 #include "xbps_api_impl.h"
+#include "thor_policy.h"
 
 /**
  * @file lib/transaction_prepare.c
@@ -275,6 +276,36 @@ xbps_transaction_init(struct xbps_handle *xhp)
 	return 0;
 }
 
+static int
+thor_check_transaction(struct xbps_handle *xhp)
+{
+	xbps_array_t pkgs = xbps_dictionary_get(xhp->transd, "packages");
+	int denied = 0;
+
+	for (unsigned int i = 0; i < xbps_array_count(pkgs); i++) {
+		xbps_dictionary_t obj = xbps_array_get(pkgs, i);
+		const char *pkgname = NULL, *pkgver = NULL, *reason = NULL;
+		xbps_trans_type_t ttype = xbps_transaction_pkg_type(obj);
+
+		if (ttype != XBPS_TRANS_INSTALL && ttype != XBPS_TRANS_UPDATE &&
+		    ttype != XBPS_TRANS_REINSTALL)
+			continue;
+		if (!xbps_dictionary_get_cstring_nocopy(obj, "pkgname", &pkgname) ||
+		    !xbps_dictionary_get_cstring_nocopy(obj, "pkgver", &pkgver))
+			continue;
+		if (thor_transaction_pkg(xhp->rootdir, pkgname, &reason) != 0) {
+			xbps_error_printf("thor: %s запрещён: %s\n", pkgver, reason);
+			denied++;
+		}
+	}
+	if (denied) {
+		xbps_error_printf("thor: транзакция отменена; разрешить пакет: "
+		    "doas thor allow ИМЯ (docs/18)\n");
+		return EPERM;
+	}
+	return 0;
+}
+
 int
 xbps_transaction_prepare(struct xbps_handle *xhp)
 {
@@ -426,6 +457,14 @@ out:
 	if ((rv = compute_transaction_stats(xhp)) != 0) {
 		return rv;
 	}
+	/*
+	 * thor: пакеты из чёрного списка (thor_policy.h) — и при обновлениях.
+	 */
+	if ((rv = thor_check_transaction(xhp)) != 0) {
+		xbps_object_release(xhp->transd);
+		xhp->transd = NULL;
+		return rv;
+	}
 	/*
 	 * Make transaction dictionary immutable.
 	 */
