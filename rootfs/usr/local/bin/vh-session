#!/bin/sh
# void-hardened: графический сеанс повседневного пользователя (docs/08, docs/12).
# Запускается из login-шелла на tty1 (/etc/profile.d/zz-vh.sh) через exec.
set -u
if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -d "$XDG_RUNTIME_DIR" ]; then
	echo "vh-session: нет XDG_RUNTIME_DIR (pam_dumb_runtime_dir)" >&2
	sleep 5
	exit 1
fi
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=mango LIBSEAT_BACKEND=seatd
# Firefox и GTK — только Wayland; Xwayland не установлен
export MOZ_ENABLE_WAYLAND=1 GDK_BACKEND=wayland
cd "$HOME" || exit 1

mango 2>"$XDG_RUNTIME_DIR/mango.log"

# Сеанс закончился (выход или падение mango): ни один процесс пользователя его
# не переживает — ни отвязавшийся через setsid демон, ни родитель-doas браузера
# (его гибель завершает всю песочницу: bwrap --die-with-parent). kill -1 не
# трогает сам этот процесс; после него — снова приглашение входа.
kill -KILL -1 2>/dev/null
# dumb_runtime_dir не удаляет /run/user/UID при выходе — чистим сами
find "$XDG_RUNTIME_DIR" -mindepth 1 -delete 2>/dev/null
exit 0
