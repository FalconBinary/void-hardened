#!/usr/bin/python3 -I
"""vh-pkg — установка программ с проверкой и обезвреживанием (docs/12, раздел «Программы»).

  doas vh-pkg add ПАКЕТ… [--ignore ЗАВИСИМОСТЬ…] [--keep ПУТЬ…] [-y]
  doas vh-pkg scan ПАКЕТ…        — разобрать уже установленные пакеты (vh-update — сам)
  doas vh-pkg rm ПАКЕТ…          — удалить вместе с ненужными больше зависимостями

У xbps нет хуков «после установки пакета», поэтому ставить через эту обёртку:

1. До установки — список всего, что потянется (xbps-install -n). Пакеты из чёрного
   списка (компиляторы, polkit, elogind, avahi, cups, NetworkManager, Xwayland, cron…)
   показываются с причиной; без подтверждения установка не идёт. Ненужную зависимость
   можно не ставить: --ignore ИМЯ (ignorepkg в /etc/xbps.d — проверьте, что программа
   работает без неё).
2. После установки — разбор файлов каждого нового пакета:
     SUID/SGID, file capabilities  → снимаются; путь в /etc/vh/suid-strip.list
                                     (vh-suid-strip снимает их снова после обновлений);
     sysctl.d                      → маскируется одноимённым пустым файлом в /etc/sysctl.d
                                     (иначе файл пакета 99-* перекрыл бы 30-vh-hardening);
     правила udev с MODE 0666/0777 → маскируются в /etc/udev/rules.d (устройство для всех);
     хуки /etc/kernel.d, модули dracut, скрипты profile.d/bashrc.d
                                   → не распаковываются (noextract) и удаляются: они
                                     исполняются от root при сборке UKI или в каждом шелле;
     сервисы runit, D-Bus, автозапуск XDG, cron
                                   → только отчёт: в этой системе они не запускаются сами.
   Исключение для конкретного файла: --keep ПУТЬ.
3. Сироты (зависимости, которые больше никому не нужны) — xbps-remove -o.
"""
import argparse
import os
import re
import stat
import subprocess
import sys

NOEXTRACT = "/etc/xbps.d/50-vh-pkg.conf"
IGNORE = "/etc/xbps.d/51-vh-pkg-ignore.conf"
STRIP_LIST = "/etc/vh/suid-strip.list"
DENY = {
    # компиляторы: вредонос собрал бы инструмент на месте
    "gcc": "компилятор C (часто тянет libgccjit — например, emacs-pgtk/gtk3)",
    "clang": "компилятор C", "tcc": "компилятор C", "make": "система сборки",
    "rust": "компилятор", "go": "компилятор",
    # привилегированные демоны и помощники
    "polkit": "SUID pkexec и демон прав — здесь его работу делает doas",
    "elogind": "менеджер сеансов — здесь seatd",
    "udisks2": "монтирование дисков без пароля через D-Bus",
    "gvfs": "демоны виртуальных ФС", "avahi": "mDNS: рассылает имя в сеть, слушает порт",
    "cups": "сервер печати, слушает порт", "NetworkManager": "второй менеджер сети рядом с iwd",
    "ModemManager": "демон модемов", "connman": "второй менеджер сети",
    "wpa_supplicant": "второй Wi-Fi-демон рядом с iwd", "openssh": "содержит сервер sshd (сервис не включайте)",
    "sudo": "второй SUID-инструмент повышения прав", "usbguard": "тянет polkit",
    "cronie": "планировщик — точка закрепления", "dcron": "планировщик", "fcron": "планировщик",
    "snooze": "планировщик", "at": "планировщик",
    "xorg-server": "X11: нет изоляции окон", "xorg-server-xwayland": "Xwayland: нет изоляции окон",
    "xdg-desktop-portal": "D-Bus-порталы", "gnome-keyring": "демон ключей с D-Bus",
    "pulseaudio": "конфликтует с PipeWire", "fuse": "SUID fusermount; модуль fuse запрещён",
    "fuse3": "SUID fusermount3; модуль fuse запрещён", "flatpak": "нужны userns и fuse",
    "podman": "нужны userns и overlay", "docker": "root-демон, нужны overlay и iptables",
    "tlp": "демон питания — работу делает vh-power", "thermald": "демон питания",
    "power-profiles-daemon": "демон питания", "auto-cpufreq": "демон питания",
    "acpid": "усыпляет по крышке — здесь vh-acpid",
}
DENY_PREFIX = {"xdg-desktop-portal-": "D-Bus-порталы", "llvm": "компилятор (LLVM)"}


def die(msg):
    print(f"vh-pkg: {msg}", file=sys.stderr)
    sys.exit(1)


def sh(*cmd, check=True, capture=True):
    r = subprocess.run(cmd, text=True, capture_output=capture)
    if check and r.returncode != 0:
        die(f"{' '.join(cmd)}: {(r.stderr or r.stdout).strip()}")
    return r


def pkgname(pkgver):
    return pkgver.rsplit("-", 1)[0]


def deny_reason(name):
    if name in DENY:
        return DENY[name]
    for p, why in DENY_PREFIX.items():
        if name.startswith(p):
            return why
    return None


def ask(question, yes):
    if yes:
        return True
    try:
        return input(f"{question} [y/N] ").strip().lower() in ("y", "д", "yes", "да")
    except EOFError:
        return False


def append_unique(path, line, header):
    lines = []
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    if line in lines:
        return False
    if not lines:
        lines = [header]
    lines.append(line)
    tmp = path + ".new"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    return True


def files_of(name):
    r = sh("xbps-query", "-f", name, check=False)
    out = []
    for line in r.stdout.splitlines():
        out.append(line.split(" -> ", 1)[0].strip())
    return [f for f in out if f.startswith("/")]


def mask(path, dst_dir, why):
    """Пустой одноимённый файл в /etc маскирует файл пакета (udev, sysctl)."""
    dst = os.path.join(dst_dir, os.path.basename(path))
    if os.path.exists(dst):
        return f"уже есть {dst}"
    os.makedirs(dst_dir, exist_ok=True)
    with open(dst, "w", encoding="utf-8") as f:
        f.write(f"# void-hardened (vh-pkg): маскирует {path} — {why}\n")
    os.chmod(dst, 0o644)
    return f"замаскирован файлом {dst}"


def drop(path, name, why):
    """noextract (переживает обновления) + удалить сейчас."""
    append_unique(NOEXTRACT, f"noextract={path}",
                  "# void-hardened: файлы пакетов, которые vh-pkg запретил распаковывать (docs/12)")
    try:
        os.remove(path)
    except FileNotFoundError:
        pass
    return f"удалён и не будет распакован при обновлениях ({why})"


def scan(names, keep):
    """Разобрать файлы пакетов. Возвращает число обезвреженных объектов."""
    acted = 0
    for name in names:
        report = []
        for f in files_of(name):
            if f in keep or not os.path.lexists(f):
                continue
            try:
                st = os.lstat(f)
            except OSError:
                continue
            if stat.S_ISREG(st.st_mode):
                if st.st_mode & (stat.S_ISUID | stat.S_ISGID):
                    os.chmod(f, stat.S_IMODE(st.st_mode) & ~(stat.S_ISUID | stat.S_ISGID))
                    append_unique(STRIP_LIST, f, "# void-hardened: снимать SUID/SGID и capabilities после обновлений (vh-pkg)")
                    report.append(f"SUID/SGID снят: {f} (для root программа работает и так)")
                    acted += 1
                caps = sh("getcap", f, check=False).stdout.strip()
                if caps:
                    sh("setcap", "-r", f, check=False)
                    append_unique(STRIP_LIST, f, "# void-hardened: снимать SUID/SGID и capabilities после обновлений (vh-pkg)")
                    report.append(f"capabilities сняты: {caps}")
                    acted += 1
            if re.match(r"^/(usr/lib|etc|run)/sysctl\.d/.+\.conf$", f) and not f.startswith("/etc/sysctl.d/"):
                report.append(f"sysctl {f}: {mask(f, '/etc/sysctl.d', 'перекрыл бы sysctl защиты')}")
                acted += 1
            elif re.match(r"^/(usr/lib|etc)/udev/rules\.d/.+\.rules$", f) and stat.S_ISREG(st.st_mode):
                text = open(f, encoding="utf-8", errors="replace").read()
                if re.search(r'MODE\s*:?=\s*"0?(666|777|766|776|677)"', text):
                    if f.startswith("/etc/"):
                        report.append(f"udev {f}: даёт устройство всем (MODE 0666) — {drop(f, name, 'устройство для всех')}")
                    else:
                        report.append(f"udev {f}: даёт устройство всем (MODE 0666) — {mask(f, '/etc/udev/rules.d', 'устройство для всех')}")
                    acted += 1
                elif re.search(r'RUN\+?=|MODE|GROUP|OWNER', text):
                    report.append(f"udev {f}: правило прав/запуска — проверьте: {f}")
            elif f.startswith("/etc/kernel.d/"):
                report.append(f"хук ядра {f}: {drop(f, name, 'исполняется от root при каждой сборке UKI')}")
                acted += 1
            elif f.startswith("/usr/lib/dracut/modules.d/") and f.endswith("module-setup.sh"):
                d = os.path.dirname(f)
                for g in files_of(name):
                    if g.startswith(d + "/") and g not in keep:
                        drop(g, name, "модуль dracut")
                report.append(f"модуль dracut {d}: удалён и не будет распакован (попал бы в initramfs)")
                acted += 1
            elif re.match(r"^/etc/(profile\.d/.+\.sh|bash/bashrc\.d/.+)$", f) and stat.S_ISREG(st.st_mode):
                report.append(f"скрипт входа {f}: {drop(f, name, 'исполнялся бы в каждом шелле, в том числе у админа')}")
                acted += 1
            elif re.match(r"^/etc/sv/[^/]+/run$", f):
                svc = f.split("/")[3]
                on = os.path.exists(f"/var/service/{svc}")
                report.append(f"сервис runit {svc}: {'ВКЛЮЧЁН — проверьте, нужен ли' if on else 'установлен, но не включён (Void сам не включает)'}")
            elif f.startswith("/usr/share/dbus-1/system-services/"):
                report.append(f"D-Bus-сервис {os.path.basename(f)}: не запустится сам (активация выключена)")
            elif f.startswith(("/etc/xdg/autostart/", "/etc/cron")):
                report.append(f"автозапуск {f}: mango и runit его не исполняют")
            elif re.match(r"^/(usr/lib|etc)/modprobe\.d/", f):
                report.append(f"modprobe.d {f}: проверьте (modules_disabled, module_blacklist)")
        if report:
            print(f"── {name}")
            for r in report:
                print(f"   {r}")
    return acted


def cmd_add(a):
    if os.path.exists("/etc/vh/optional/strict-net"):
        sh("/usr/local/sbin/vh-net", "xbps", "30", capture=False)
    for dep in a.ignore:
        if append_unique(IGNORE, f"ignorepkg={dep}",
                         "# void-hardened: зависимости, которые vh-pkg по просьбе админа не ставит (docs/12)"):
            print(f"ignorepkg={dep}: зависимость не будет ставиться (проверьте, что программа работает)")
    r = sh("xbps-install", "-Sn", *a.pkgs, check=False)
    if r.returncode not in (0, 6):          # 6: всё уже установлено
        die((r.stderr or r.stdout).strip())
    plan = [line.split()[0] for line in r.stdout.splitlines()
            if len(line.split()) >= 2 and line.split()[1] in ("install", "update")]
    if not plan:
        print("нечего ставить — всё уже установлено")
        return
    print(f"Будет установлено ({len(plan)}):")
    bad = []
    for pv in plan:
        n = pkgname(pv)
        why = deny_reason(n)
        print(f"   {'!!' if why else '  '} {pv}{'  — ' + why if why else ''}")
        if why:
            bad.append(n)
    if bad:
        deps = [n for n in bad if n not in a.pkgs]
        print("\nВ списке нежелательное (!!).")
        if deps:
            print("Если программа работает без этих зависимостей, не ставьте их:")
            print(f"   doas vh-pkg add {' '.join(a.pkgs)} " + " ".join(f"--ignore {n}" for n in deps))
        if not ask("Ставить всё равно?", False):
            die("отменено")
    elif not ask("Установить?", a.yes):
        die("отменено")
    sh("xbps-install", "-y", *a.pkgs, capture=False)
    print("\nРазбор файлов новых пакетов:")
    n = scan([pkgname(pv) for pv in plan], set(a.keep))
    sh("xbps-remove", "-oy", check=False, capture=False)
    sh("/usr/local/sbin/vh-suid-strip", "--quiet", check=False)
    print(f"\nОбезврежено объектов: {n}. Проверка всей системы: doas vh-audit")


def main():
    if os.geteuid() != 0:
        die("запустите: doas vh-pkg …")
    ap = argparse.ArgumentParser(prog="vh-pkg")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("add")
    p.add_argument("pkgs", nargs="+")
    p.add_argument("--ignore", action="append", default=[])
    p.add_argument("--keep", action="append", default=[])
    p.add_argument("-y", "--yes", action="store_true")
    p = sub.add_parser("scan")
    p.add_argument("pkgs", nargs="+")
    p.add_argument("--keep", action="append", default=[])
    p = sub.add_parser("rm")
    p.add_argument("pkgs", nargs="+")
    a = ap.parse_args()
    if a.cmd == "add":
        cmd_add(a)
    elif a.cmd == "scan":
        n = scan(a.pkgs, set(a.keep))
        sh("/usr/local/sbin/vh-suid-strip", "--quiet", check=False)
        print(f"обезврежено объектов: {n}")
    else:
        sh("xbps-remove", "-Ry", *a.pkgs, capture=False)
        sh("xbps-remove", "-oy", check=False, capture=False)


if __name__ == "__main__":
    main()
