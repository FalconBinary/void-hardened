#!/usr/bin/python3 -I
"""Пересборка цепочки загрузки на ESP.

1. Оставляет на ESP KEEP последних UKI (+ UKI работающего ядра), остальные удаляет.
2. Подписывает UKI ключом db (sbctl).
3. Пишет limine.conf: по записи на UKI, путь с хэшем BLAKE2B (Limine сверяет файл).
4. Берёт чистый BOOTX64.EFI из пакета limine, вписывает в него BLAKE2B конфига
   (limine enroll-config), подписывает и атомарно заменяет копию на ESP.

С Secure Boot и вписанным хэшем Limine проверяет конфиг при каждой загрузке,
отключает редактор и требует хэши у всех путей (docs/03-boot.md).

  vh-limine-update [--new ВЕРСИЯ] [--dry-run]
"""
import argparse
import glob
import hashlib
import os
import re
import shutil
import subprocess
import sys
import tempfile

ESP = "/boot/efi"
UKI_DIR = ESP + "/EFI/void"
LIMINE_DIR = ESP + "/EFI/BOOT"
LIMINE_SRC = "/usr/share/limine/BOOTX64.EFI"
BOOT_CONF = "/etc/vh/boot.conf"
DB_KEY = "/var/lib/sbctl/keys/db/db.key"
UKI_RE = re.compile(r"^linux-(\d+)\.(\d+)\.(\d+)_(\d+)\.efi$")


def die(msg):
    print(f"vh-limine-update: {msg}", file=sys.stderr)
    sys.exit(1)


def secure_boot_enabled():
    for f in glob.glob("/sys/firmware/efi/efivars/SecureBoot-*"):
        with open(f, "rb") as fh:
            return fh.read()[4:5] == b"\x01"
    return False


def read_conf():
    conf = {"KEEP": "2", "TIMEOUT": "1", "KEYS_OFFLINE": "no"}
    try:
        with open(BOOT_CONF, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    conf[k.strip()] = v.strip().strip('"')
    except FileNotFoundError:
        pass
    keep, timeout = int(conf["KEEP"]), int(conf["TIMEOUT"])
    if not 1 <= keep <= 5 or not 0 <= timeout <= 30:
        die(f"неверные KEEP/TIMEOUT в {BOOT_CONF}")
    return keep, timeout, conf["KEYS_OFFLINE"] == "yes"


def blake2b(path=None, data=None):
    h = hashlib.blake2b()  # 512 бит — формат, который ждёт Limine
    if data is not None:
        h.update(data)
    else:
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                h.update(chunk)
    return h.hexdigest()


def sign(path, dry, offline=False):
    if not os.path.exists(DB_KEY):
        if offline:
            die(f"носитель с ключом не подключён ({DB_KEY}) — подпись невозможна.\n"
                "  Подключите его и повторите: doas vh-keys mount && doas xbps-reconfigure -f "
                "<пакет ядра>; затем doas vh-keys umount (docs/13, sb-offline-keys)")
        if secure_boot_enabled():
            die(f"Secure Boot включён, а ключа {DB_KEY} нет: неподписанную UKI прошивка не "
                "загрузит. limine.conf не изменён — загрузится прежнее ядро")
        print(f"  ключей Secure Boot ещё нет ({DB_KEY}) — {path} не подписан")
        return
    if dry:
        print(f"  + sbctl sign {path}")
        return
    r = subprocess.run(["sbctl", "sign", path], capture_output=True, text=True)
    if r.returncode != 0:
        die(f"sbctl sign {path}: {r.stdout}{r.stderr}")


def replace_atomic(data_path, dst):
    tmp = dst + ".new"
    shutil.copyfile(data_path, tmp)
    with open(tmp, "rb") as f:
        os.fsync(f.fileno())
    os.replace(tmp, dst)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--new", help="версия только что установленного ядра")
    ap.add_argument("--dry-run", action="store_true")
    a = ap.parse_args()

    if not os.path.ismount(ESP):
        die(f"{ESP} не смонтирован — подпись отменена (UKI не должна лечь на корень)")
    keep_n, timeout, offline = read_conf()

    ukis = []
    for name in os.listdir(UKI_DIR) if os.path.isdir(UKI_DIR) else []:
        m = UKI_RE.match(name)
        if m:
            ukis.append((tuple(int(x) for x in m.groups()), name))
        elif name.endswith(".efi"):
            print(f"  внимание: незнакомый файл {UKI_DIR}/{name} — не трогаю")
    if not ukis:
        die(f"в {UKI_DIR} нет UKI")
    ukis.sort(reverse=True)
    names = [n for _, n in ukis]
    if a.new and f"linux-{a.new}.efi" not in names:
        die(f"UKI для {a.new} не создана — смотрите вывод dracut выше")

    keep = names[:keep_n]
    running = f"linux-{os.uname().release}.efi"
    if running in names and running not in keep:
        keep.append(running)  # ядро, на котором работаем, не удаляем никогда

    # Сначала проверка и подпись, потом удаление: сбой подписи оставляет ESP как был
    # (прежний limine.conf ссылается на прежние, подписанные UKI).
    if offline and a.new and not a.dry_run:
        r = subprocess.run(["/usr/local/sbin/vh-uki-verify", os.path.join(UKI_DIR, f"linux-{a.new}.efi"), a.new])
        if r.returncode != 0:
            die("проверка входных данных UKI не пройдена — подпись отменена (docs/13)")
    for n in keep:
        sign(os.path.join(UKI_DIR, n), a.dry_run, offline)
    for n in names:
        if n not in keep:
            print(f"  удаляю устаревшую UKI {n}")
            if not a.dry_run:
                os.remove(os.path.join(UKI_DIR, n))

    lines = [
        "# Сгенерировано vh-limine-update — не редактировать вручную:",
        "# хэш этого файла вписан в BOOTX64.EFI, любая правка = отказ загрузки.",
        f"timeout: {timeout}",
        "editor_enabled: no",
        "hash_mismatch_panic: yes",
        "verbose: no",
        "",
    ]
    for i, n in enumerate(keep):
        path = os.path.join(UKI_DIR, n)
        ver = UKI_RE.match(n)
        title = "Void Linux {}.{}.{}_{}".format(*ver.groups())
        if i > 0:
            title += " (предыдущее ядро)"
        lines += [f"/{title}", "    protocol: efi",
                  f"    path: boot():/EFI/void/{n}#{blake2b(path)}", ""]
    conf = ("\n".join(lines)).encode()
    conf_hash = blake2b(data=conf)

    if a.new and not a.dry_run and os.path.exists("/etc/vh/totp.conf"):
        # optional/tpm2-totp: новая UKI меняет PCR 4 — при следующей загрузке initramfs
        # предложит перезапечатать секрет (флаг: только факт наличия файла)
        os.makedirs("/var/lib/vh", mode=0o700, exist_ok=True)
        open("/var/lib/vh/totp-reseal", "w").close()
        print("  tpm2-totp: при следующей загрузке код один раз не совпадёт — перезапечатайте (RESEAL)")

    if a.dry_run:
        print(conf.decode())
        print(f"  + limine enroll-config BOOTX64.EFI {conf_hash}")
        return

    os.makedirs(LIMINE_DIR, exist_ok=True)
    with tempfile.TemporaryDirectory() as td:
        cfg_tmp = os.path.join(td, "limine.conf")
        with open(cfg_tmp, "wb") as f:
            f.write(conf)
        efi_tmp = os.path.join(td, "BOOTX64.EFI")
        shutil.copyfile(LIMINE_SRC, efi_tmp)  # чистая копия: подпись и старый хэш не наследуются
        r = subprocess.run(["limine", "enroll-config", efi_tmp, conf_hash],
                           capture_output=True, text=True)
        if r.returncode != 0:
            die(f"limine enroll-config: {r.stdout}{r.stderr}")
        sign(efi_tmp, False, offline)
        # Порядок важен: сначала конфиг, потом загрузчик. Сбой между ними даёт
        # «хэш не совпал» (отказ загрузки, но не обход проверки); повторный запуск чинит.
        replace_atomic(cfg_tmp, os.path.join(LIMINE_DIR, "limine.conf"))
        replace_atomic(efi_tmp, os.path.join(LIMINE_DIR, "BOOTX64.EFI"))
    os.sync()
    print(f"  limine.conf: {len(keep)} записей, хэш конфига {conf_hash[:16]}… вписан в Limine")


if __name__ == "__main__":
    main()
