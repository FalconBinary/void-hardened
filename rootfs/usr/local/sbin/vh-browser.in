#!/bin/sh
# void-hardened: root-лаунчер браузера (docs/08). Вызывается только через doas
# правилом без пароля: «permit nopass @VH_USER@ as root cmd /usr/local/sbin/vh-browser
# args trusted|untrusted». Делает одно: сбрасывает права на пользователя браузера и
# запускает сборку песочницы. Каждая ступень — exec: родителем bwrap остаётся сам
# процесс doas, и его гибель (конец сеанса: kill -KILL -1) завершает песочницу
# (bwrap --die-with-parent).
set -eu
PATH=/usr/bin
case ${1:-} in trusted|untrusted) ;; *) echo "использование: vh-browser trusted|untrusted" >&2; exit 2 ;; esac
[ "${DOAS_USER:-}" = "@VH_USER@" ] || { echo "vh-browser: только для @VH_USER@ через doas" >&2; exit 1; }
[ -S /run/vh-sandbox/wayland ] || { echo "vh-browser: нет /run/vh-sandbox/wayland — vh-wlfilter не запущен" >&2; exit 1; }
# nsenter — в сетевое пространство init: если сеанс пользователя живёт в пустом netns
# (optional/session-netns), браузеру сеть всё равно нужна. В базовом слое это no-op.
exec nsenter --net=/proc/1/ns/net -- \
	setpriv --reuid=@VH_BROWSER_USER@ --regid=@VH_BROWSER_USER@ --init-groups --reset-env \
	--no-new-privs --inh-caps=-all --bounding-set=-all \
	/usr/local/libexec/vh/browser-sandbox "$1"
