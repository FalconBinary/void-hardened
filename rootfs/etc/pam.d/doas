#%PAM-1.0
# void-hardened: doas. faillock — как у входа; umask 077 вместо 022 (файлы,
# созданные через doas, по умолчанию закрыты; нужные права задавайте явно).
# При «nopass» doas не вызывает стек auth, но выполняет account и session.
auth       required   pam_faillock.so preauth
auth       sufficient pam_unix.so     try_first_pass
auth       [default=die] pam_faillock.so authfail

account    required   pam_faillock.so
account    include    system-auth

session    include    system-auth
session    optional   pam_umask.so    usergroups umask=077
