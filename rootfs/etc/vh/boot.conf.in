# Настройки vh-limine-update (docs/03).
# Сколько UKI держать на ESP: текущая и одна предыдущая. Устаревшие удаляются —
# удаление не отзывает подпись, но сокращает выбор для отката (docs/09).
KEEP=2
TIMEOUT=@VH_LIMINE_TIMEOUT@
# Ключ подписи Secure Boot на отдельном носителе (optional/sb-offline-keys): yes —
# без подключённого носителя подпись невозможна, а перед подписью UKI проверяется
# по эталонам с того же носителя (vh-uki-verify).
KEYS_OFFLINE=no
