# vim: set ts=4 sw=4 et:
# void-hardened: каталоги в /run и профиль питания при загрузке.
# /run/vh-sandbox — сокеты, через которые песочница браузера получает Wayland и
# звук (docs/08). Владелец — повседневный пользователь, группа — пользователь браузера.
install -d -m 0750 -o @VH_USER@ -g @VH_BROWSER_USER@ /run/vh-sandbox
# Профиль «от сети / от батареи» (дальше его переключает udev-правило).
/usr/local/sbin/vh-power boot
