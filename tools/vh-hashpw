#!/usr/bin/python3 -I
"""Хэш пароля yescrypt через libcrypt (libxcrypt) — только для автотестов в VM.
В python 3.13+ модуля crypt нет; chpasswd из shadow 4.8.1 не умеет yescrypt.
  printf '%s' ПАРОЛЬ | vh-hashpw [cost]  → $y$...
На реальной машине пароли задаются интерактивно командой passwd."""
import ctypes
import sys

cost = int(sys.argv[1]) if len(sys.argv) > 1 else 7
pw = sys.stdin.buffer.read()
lib = ctypes.CDLL("libcrypt.so.2")
lib.crypt_gensalt.restype = ctypes.c_char_p
lib.crypt_gensalt.argtypes = [ctypes.c_char_p, ctypes.c_ulong, ctypes.c_char_p, ctypes.c_int]
lib.crypt.restype = ctypes.c_char_p
lib.crypt.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
salt = lib.crypt_gensalt(b"$y$", cost, None, 0)
h = lib.crypt(pw, salt)
if not h or not h.startswith(b"$y$"):
    sys.exit("vh-hashpw: libcrypt не вернул yescrypt")
print(h.decode())
