#!/usr/bin/python3 -I
"""vh-usb-udev — решение об авторизации USB (optional/usb-auth, docs/13). Вызывается udev.

Ядро загружено с usbcore.authorized_default=2: устройства на внутренних портах
(connect_type=hardwired по ACPI) авторизуются сами, внешние — нет. У корневых хабов
interface_authorized_default=0: даже у авторизованного устройства интерфейсы
создаются неавторизованными, драйвер к ним не привязывается. Этот помощник решает:

  интерфейс внутреннего устройства  → авторизовать (кроме камеры при VH_CAMERA=no и
                                       Bluetooth при VH_BLUETOOTH=off);
  свой FIDO2-ключ из /etc/vh/usb-keys.conf (точный порт, VID:PID, serial,
  один интерфейс HID)              → авторизовать устройство и его интерфейс;
  устройство, подключённое «vh-usb attach» → только интерфейсы класса 08 (накопитель);
  всё прочее                        → остаётся неавторизованным (BadUSB-клавиатура мертва).

  vh-usb-udev device|interface DEVPATH
"""
import os
import sys

SYS = "/sys"
KEYS = "/etc/vh/usb-keys.conf"
ENV = "/etc/vh/vh.env"
ATTACH_DIR = "/run/vh/usb-attach"


def rd(path):
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            return f.read().strip()
    except OSError:
        return ""


def wr(path, val):
    try:
        with open(path, "w") as f:
            f.write(val)
    except OSError as e:
        log(f"запись {path}: {e}")


def log(msg):
    try:
        with open("/dev/kmsg", "w") as f:
            f.write(f"<5>vh-usb: {msg}\n")
    except OSError:
        pass


def env():
    out = {}
    for line in rd(ENV).splitlines():
        if "=" in line and not line.startswith("#"):
            k, v = line.split("=", 1)
            out[k] = v.strip('"')
    return out


def internal(dev):
    """Порт устройства «hardwired» по ACPI (встроенная камера, Bluetooth, клавиатура)."""
    return rd(f"{dev}/port/connect_type") == "hardwired"


def interfaces_from_descriptors(dev):
    """[(class, subclass, protocol)] всех интерфейсов из сырых дескрипторов: у
    неавторизованного устройства активной конфигурации нет, но дескрипторы прочитаны."""
    try:
        with open(f"{dev}/descriptors", "rb") as f:
            raw = f.read()
    except OSError:
        return []
    out, off = [], 0
    while off + 2 <= len(raw):
        ln, typ = raw[off], raw[off + 1]
        if ln < 2:
            break
        if typ == 4 and ln >= 9:              # INTERFACE
            out.append((raw[off + 5], raw[off + 6], raw[off + 7]))
        off += ln
    return out


def key_match(dev):
    port = os.path.basename(dev)
    vidpid = f"{rd(dev + '/idVendor')}:{rd(dev + '/idProduct')}"
    serial = rd(dev + "/serial")
    for line in rd(KEYS).splitlines():
        f = line.split()
        if len(f) >= 3 and not line.startswith("#") and f[0] == port and f[1] == vidpid and f[2] == serial:
            ifs = interfaces_from_descriptors(dev)
            # FIDO: ровно один интерфейс, HID, без boot-протокола клавиатуры/мыши
            return len(ifs) == 1 and ifs[0][0] == 0x03 and ifs[0][2] == 0x00
    return False


def on_device(dev):
    if rd(f"{dev}/authorized") == "1":
        return
    if key_match(dev):
        log(f"свой FIDO-ключ на {os.path.basename(dev)} — авторизую")
        wr(f"{dev}/authorized", "1")
        return
    log(f"заблокировано: {os.path.basename(dev)} {rd(dev + '/idVendor')}:{rd(dev + '/idProduct')} "
        f"«{rd(dev + '/manufacturer')} {rd(dev + '/product')}» — флешка: vh-usb attach")
    os.makedirs("/run/vh", exist_ok=True)
    wr("/run/vh/usb-blocked", os.path.basename(dev))


def on_interface(intf):
    dev = os.path.dirname(intf)
    cls = int(rd(f"{intf}/bInterfaceClass") or "ff", 16)
    if rd(f"{intf}/authorized") == "1":
        return
    port = os.path.basename(dev)
    if os.path.exists(f"{ATTACH_DIR}/{port}"):
        if cls == 0x08:
            wr(f"{intf}/authorized", "1")
        return
    if key_match(dev) and cls == 0x03:
        wr(f"{intf}/authorized", "1")
        return
    if internal(dev):
        e = env()
        if cls == 0x0E and e.get("VH_CAMERA") != "yes":
            return                                # камера: только профиль звонков
        if cls == 0xE0 and e.get("VH_BLUETOOTH") == "off":
            return
        wr(f"{intf}/authorized", "1")


def main():
    if len(sys.argv) != 3:
        sys.exit(2)
    path = os.path.realpath(SYS + sys.argv[2])
    if not path.startswith(SYS + "/devices/"):
        sys.exit(2)
    (on_device if sys.argv[1] == "device" else on_interface)(path)


if __name__ == "__main__":
    main()
