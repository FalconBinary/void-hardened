#!/usr/bin/python3 -I
"""vh-deadman — стирание ключа LUKS и открытого текста из RAM (optional/deadman, docs/13).

Два режима выключения:
  тревожный  — извлечение метки (USB-устройство) или комбинация клавиш на встроенной
               клавиатуре: ключ тома стирается за доли секунды, данные последних секунд
               не сохраняются;
  штатный    — стадия 3 runit (кнопка питания, крышка, простой, doas poweroff): сервисы
               остановлены, данные сброшены, корень только для чтения — затем то же
               стирание (shutdown.d/85-vh-deadman.sh вызывает «vh-deadman final»).

Порядок после триггера (без fork, exec и чтения с диска — всё загружено заранее):
  1. DM_DEV_SUSPEND с NOFLUSH|SKIP_LOCKFS + DM_TARGET_MSG «key wipe» для каждого тома
     dm-crypt — ключ тома стёрт из памяти ядра; после этого читать с диска нельзя;
  2. kill(-1, SIGKILL) — память процессов освобождается и (init_on_free=1) обнуляется;
  3. swapoff и reset zram — zsmalloc не обнуляет освобождённые объекты сам;
  4. drop_caches=3 — page cache с расшифрованными файлами, dentry и inode;
  5. MOR есть: флаг VhPoweroff в NVRAM и sysrq b — прошивка стирает RAM при POST, а
     initramfs по флагу выключает машину (91vhdeadman); MOR нет: sysrq o.
Остаточный риск: процессы, застрявшие в D-state на приостановленном томе, и грязные
страницы недавно записанных файлов (без MOR — в RAM до потери питания); длинное нажатие
кнопки питания обходит всё это.

  vh-deadman daemon   — резидентный режим (runit-сервис vh-deadman)
  vh-deadman final    — финал штатного выключения (стадия 3)
  vh-deadman test     — показать, что найдено, ничего не делая
"""
import ctypes
import glob
import os
import select
import socket
import struct
import sys
import time
import fcntl

CONF = "/etc/vh/deadman.conf"
# GUID LINUX_EFI_CRASH_GUID: переменные с ним efivarfs создаёт удаляемыми — initramfs
# снимет флаг без chattr. Имя не начинается с dump- — efi-pstore его не трогает.
EFI_FLAG = "VhPoweroff-cfc8fc79-be2e-4ddc-97f0-9f98bfe298a0"
MOR_VAR = "MemoryOverwriteRequestControl-e20939be-32d4-41be-a150-897f85d49829"
DM_SIZE = 312                                   # sizeof(struct dm_ioctl)
DM_DEV_SUSPEND = (3 << 30) | (DM_SIZE << 16) | (0xFD << 8) | 6
DM_TARGET_MSG = (3 << 30) | (DM_SIZE << 16) | (0xFD << 8) | 14
DM_SUSPEND_FLAG, DM_SKIP_LOCKFS_FLAG, DM_NOFLUSH_FLAG = 1 << 1, 1 << 10, 1 << 11
NETLINK_KOBJECT_UEVENT = 15
EV_KEY = 1
KEY_RIGHTCTRL, KEY_RIGHTALT, KEY_END = 97, 100, 107
EVENT = struct.Struct("llHHi")


def log(msg):
    print(f"vh-deadman: {msg}", flush=True)


def read_conf():
    c = {"TAG": "", "COMBO": "no", "WATCHDOG": "no"}
    try:
        with open(CONF, encoding="utf-8") as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if "=" in line:
                    k, v = line.split("=", 1)
                    c[k.strip()] = v.strip().strip('"')
    except FileNotFoundError:
        pass
    return c


def dm_buf(name, flags, payload=b""):
    """struct dm_ioctl (+ данные) для имени тома."""
    size = DM_SIZE + len(payload)
    size = (size + 7) & ~7
    buf = bytearray(size)
    struct.pack_into("<3I I I I i I I I Q", buf, 0, 4, 0, 0, size, DM_SIZE, 0, 0, flags, 0, 0, 0)
    nb = name.encode()[:127]
    buf[48:48 + len(nb)] = nb
    buf[DM_SIZE:DM_SIZE + len(payload)] = payload
    return buf


class Wiper:
    """Всё, что нужно для стирания, — открыто и подготовлено заранее."""

    def __init__(self):
        self.libc = ctypes.CDLL(None, use_errno=True)
        if self.libc.mlockall(3) != 0:           # MCL_CURRENT | MCL_FUTURE
            log(f"mlockall: errno {ctypes.get_errno()} — память демона может уйти в zram")
        self.dmctl = os.open("/dev/mapper/control", os.O_RDWR | os.O_CLOEXEC)
        self.crypt = []
        for dmdir in sorted(glob.glob("/sys/block/dm-*/dm")):
            with open(f"{dmdir}/uuid") as f:
                uuid = f.read().strip()
            if not uuid.startswith("CRYPT-"):
                continue
            with open(f"{dmdir}/name") as f:
                name = f.read().strip()
            msg = struct.pack("<Q", 0) + b"key wipe\0"
            self.crypt.append((name,
                               dm_buf(name, DM_SUSPEND_FLAG | DM_SKIP_LOCKFS_FLAG | DM_NOFLUSH_FLAG),
                               dm_buf(name, 0, msg)))
        self.zram = []
        for z in sorted(glob.glob("/sys/block/zram*")):
            n = os.path.basename(z)
            self.zram.append((f"/dev/{n}".encode(), os.open(f"{z}/reset", os.O_WRONLY | os.O_CLOEXEC)))
        self.drop = os.open("/proc/sys/vm/drop_caches", os.O_WRONLY | os.O_CLOEXEC)
        self.sysrq = os.open("/proc/sysrq-trigger", os.O_WRONLY | os.O_CLOEXEC)
        self.efi = None
        if os.path.exists(f"/sys/firmware/efi/efivars/{MOR_VAR}"):
            self.efi = os.open("/sys/firmware/efi/efivars", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        self.libc.swapoff.argtypes = [ctypes.c_char_p]
        # прогрев: первые вызовы не должны ничего подгружать
        os.write(self.drop, b"1")
        time.monotonic()

    def describe(self):
        return (f"тома dm-crypt: {', '.join(n for n, _, _ in self.crypt) or 'нет'}; "
                f"zram: {len(self.zram)}; MOR: {'есть' if self.efi is not None else 'нет'}")

    def wipe(self, reboot=False):
        for _name, susp, msg in self.crypt:
            try:
                fcntl.ioctl(self.dmctl, DM_DEV_SUSPEND, susp)
                fcntl.ioctl(self.dmctl, DM_TARGET_MSG, msg)
            except OSError:
                pass                                # следующий том всё равно стираем
        try:
            os.kill(-1, 9)
        except OSError:
            pass
        time.sleep(0.3)                             # процессы выходят, слоты swap освобождаются
        for dev, reset in self.zram:
            self.libc.swapoff(dev)
            try:
                os.write(reset, b"1")
            except OSError:
                pass
        try:
            os.write(self.drop, b"3")
        except OSError:
            pass
        if self.efi is None:                        # MOR нет: выключение мимо userspace
            os.write(self.sysrq, b"b" if reboot else b"o")
        if not reboot:
            try:
                fd = os.open(EFI_FLAG, os.O_CREAT | os.O_WRONLY, 0o644, dir_fd=self.efi)
                os.write(fd, b"\x07\x00\x00\x00\x01")        # NV|BS|RT + 1 байт
                os.close(fd)
            except OSError:
                pass
        os.write(self.sysrq, b"b")                  # перезагрузка через прошивку: MOR стирает RAM


def tag_present(tag):
    """TAG = vid:pid (hex, как в lsusb). Есть ли такое USB-устройство и его DEVPATH."""
    vid, pid = tag.lower().split(":")[:2]
    for d in glob.glob("/sys/bus/usb/devices/*"):
        try:
            with open(f"{d}/idVendor") as f:
                v = f.read().strip()
            with open(f"{d}/idProduct") as f:
                p = f.read().strip()
        except OSError:
            continue
        if v == vid and p == pid:
            return os.path.realpath(d)[len("/sys"):]
    return None


def product_of(tag):
    vid, pid = tag.lower().split(":")[:2]
    return f"{int(vid, 16):x}/{int(pid, 16):x}/"


def daemon(w, conf):
    fds = {}
    nl = None
    tag = conf["TAG"]
    armed_path = None
    if tag:
        nl = socket.socket(socket.AF_NETLINK, socket.SOCK_DGRAM | socket.SOCK_CLOEXEC, NETLINK_KOBJECT_UEVENT)
        nl.bind((0, 1))
        fds[nl.fileno()] = "uevent"
        armed_path = tag_present(tag)
    kbd = None
    if conf["COMBO"] == "yes":
        for ev in glob.glob("/sys/class/input/event*"):
            try:
                with open(f"{ev}/device/phys") as f:
                    phys = f.read().strip()
            except OSError:
                continue
            if phys.startswith("isa0060/serio0"):          # встроенная клавиатура i8042
                kbd = os.open("/dev/input/" + os.path.basename(ev), os.O_RDONLY | os.O_CLOEXEC)
                fds[kbd] = "kbd"
                break
    wd = None
    if conf["WATCHDOG"] == "yes" and os.path.exists("/dev/watchdog"):
        wd = os.open("/dev/watchdog", os.O_WRONLY | os.O_CLOEXEC)
    os.makedirs("/run/vh", exist_ok=True)

    def status(s):
        with open("/run/vh/deadman", "w") as f:
            f.write(s + "\n")
    status("armed" if armed_path else "disarmed")
    log(f"{w.describe()}; метка {tag or '—'}: {'вставлена' if armed_path else 'нет'}; "
        f"комбинация: {'да' if kbd is not None else 'нет'}; сторож: {'да' if wd is not None else 'нет'}")
    down = set()
    prod = product_of(tag) if tag else None
    while True:
        if wd is not None:
            os.write(wd, b"\0")
        ready, _, _ = select.select(list(fds), [], [], 10 if wd is not None else None)
        for fd in ready:
            if fds[fd] == "uevent":
                data, (nl_pid, _groups) = nl.recvfrom(8192)
                if nl_pid != 0:
                    continue                                   # только сообщения ядра
                kv = dict(x.split("=", 1) for x in data.decode(errors="replace").split("\0") if "=" in x)
                if kv.get("SUBSYSTEM") != "usb" or kv.get("DEVTYPE") != "usb_device":
                    continue
                if not kv.get("PRODUCT", "").startswith(prod):
                    continue
                if kv.get("ACTION") == "add":
                    armed_path = kv.get("DEVPATH")
                    status("armed")
                elif kv.get("ACTION") == "remove" and armed_path and kv.get("DEVPATH") == armed_path:
                    log("метка извлечена — тревожное выключение")
                    w.wipe()
            elif fds[fd] == "kbd":
                data = os.read(fd, EVENT.size * 64)
                for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
                    _s, _us, t, code, val = EVENT.unpack_from(data, off)
                    if t != EV_KEY:
                        continue
                    if val == 1:
                        down.add(code)
                    elif val == 0:
                        down.discard(code)
                    if {KEY_RIGHTCTRL, KEY_RIGHTALT, KEY_END} <= down:
                        log("тревожная комбинация — выключение")
                        w.wipe()


def main():
    if os.geteuid() != 0:
        sys.exit("vh-deadman: нужен root")
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    conf = read_conf()
    if mode == "test":
        print(Wiper().describe(), "| метка:", conf["TAG"] or "—",
              "вставлена" if conf["TAG"] and tag_present(conf["TAG"]) else "")
    elif mode == "final":
        w = Wiper()
        if conf["WATCHDOG"] == "yes" and os.path.exists("/dev/watchdog"):
            try:
                os.write(os.open("/dev/watchdog", os.O_WRONLY), b"\0")
            except OSError:
                pass
        reboot = os.access("/run/runit/reboot", os.X_OK)
        print(f"vh-deadman: стирание ключа и RAM ({'перезагрузка' if reboot else 'выключение'})", flush=True)
        w.wipe(reboot=reboot)
    elif mode == "daemon":
        daemon(Wiper(), conf)
    else:
        print(__doc__)
        sys.exit(2)


if __name__ == "__main__":
    main()
